<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store build's sandbox. Each key is something the desk does:
     print cheques through the Mac's print system (lp and lpstat run inside
     the sandbox with this), reach the Banyan server and the printer on the
     network, and save CSV and PDF exports to the person's Downloads. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.print</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.files.downloads.read-write</key><true/>
</dict>
</plist>
